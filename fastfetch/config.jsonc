{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/lin/ico.jpg",
    "type": "sixel",
    "height": 12,
    "padding": {
      "top": 2,
      "left":3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "\u001b[37m{user-name}\u001b\n",
      "keyColor": "34",
    },
    {
      "type": "os",
      "key": " ",
    },
    {
      "type": "kernel",
      "key": " ",
    },
    {
      "type": "packages",
      "key": " ",
    },
    {
      "type": "shell",
      "key": " ",
      "format": "{}"
    },
    {
      "type": "wm",
      "key": " ",
    },
    {
      "type": "gpu",
      "key": " ",
    },
    {
      "type": "terminalfont",
      "key": " ",
    },
    {
      "type": "uptime",
      "key": " ",
    },
    {
      "type": "media",
      "key": "󰝚 ",
    },
    "break",
    "break",
  ]
}
