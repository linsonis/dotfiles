    {
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "/home/lin/herta2.jpg",
    	"type": "auto",
    	"height": 12,
    	"padding": {
    		"top": 2,
        "left":3
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
{
            // Clean SOPHOS heading
            "type": "title",
            "format": "\u001b[37m{user-name}\u001b\n",
        "keyColor": "34",
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;2;120;66;245",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "38;2;120;66;245",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "38;2;120;66;245",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "38;2;120;66;245", 
            "format": "{} (x86_64-pc-linux-gnu)"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "38;2;120;66;245", 
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "38;2;120;66;245", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "38;2;120;66;245", 
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "38;2;120;66;245", 
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "38;2;120;66;245", 
        },
        "break",
        "break",
    ]
}
